# === Dockmaster Configuration ===
# Copy this file to .env and fill in your values.
# All commented-out variables show the default or are required.

# --- Service ---
# Path to GCP service account JSON key file (used for JWT signing)
# ISSUER=/path/to/service-account-key.json

# GCP project ID for Secret Manager (RBAC storage)
# SECRETS_PROJECT=your-gcp-project-id

# Python logging level
LOG_LEVEL=INFO

# --- Authorization (comma-separated) ---
# Trusted JWT issuers
# AUTHORIZED_ISSUERS=https://accounts.google.com

# Allowed email domains
# AUTHORIZED_DOMAINS=yourdomain.com

# Allowed JWT audience values (typically Google OAuth client IDs)
# AUTHORIZED_AUDIENCE=your-client-id.apps.googleusercontent.com

# --- OAuth ---
# Google OAuth2 client ID
# CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth2 client secret
# CLIENT_SECRET=your-client-secret

# Default client ID for /refresh when not specified in request
# DEFAULT_CLIENT_ID=

# --- Session ---
# Redis connection URL for session storage
# REDIS_URL=redis://localhost:6379

# Secret key for session cookie signing (change in production!)
SESSION_SECRET_KEY=change-me-in-production
