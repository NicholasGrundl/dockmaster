# === Dockmaster Configuration ===
# Copy this file to .env and fill in your values.
# All commented-out variables show the default or are required.

# --- GCP Service Accounts ---
# Path to GCP service account JSON key file (used for JWT signing)
# ISSUER=/path/to/service-account-key.json

# GCP project ID for Secret Manager (RBAC storage)
# SECRETS_PROJECT=your-gcp-project-id

# Path to admin SA key file for RBAC write operations (empty = writes disabled, 503)
# ADMIN_SA_KEY_FILE=secrets/service-account-dockmaster-admin.json

# --- OAuth ---
# Google OAuth2 client ID
# CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth2 client secret
# CLIENT_SECRET=your-client-secret

# --- Authorization (comma-separated) ---
# Trusted JWT issuers
# AUTHORIZED_ISSUERS=https://accounts.google.com

# Allowed email domains
# AUTHORIZED_DOMAINS=yourdomain.com

# Allowed JWT audience values (typically Google OAuth client IDs)
# AUTHORIZED_AUDIENCE=your-client-id.apps.googleusercontent.com

# --- Admin ---
# Bootstrap/emergency admin emails (comma-separated). Fallback when RBAC is not yet configured.
# Remove once RBAC is self-hosting (your email granted admin via SM grants).
# DOCKMASTER_ADMIN_EMAILS=you@example.com

# --- Session ---
# Secret key for session cookie signing (REQUIRED — no default in production)
SESSION_SECRET_KEY=change-me-in-production

# Session TTL in seconds (default: 3600)
# SESSION_TTL=3600

# Redis connection URL for session storage (default: in-memory)
# REDIS_URL=redis://localhost:6379

# --- Token Issuance ---
# TTL for dockmaster-issued JWTs in seconds (default: 900)
# DOCKMASTER_TOKEN_TTL=900

# Maximum allowed token TTL on /auth/exchange (default: 3600). Requests above this are clamped.
# MAX_TOKEN_TTL=3600

# Allowed redirect URIs for OAuth code flow (comma-separated)
# ALLOWED_REDIRECT_URIS=https://myapp.example.com/callback

# Allowed CORS origins (comma-separated, empty = CORS disabled)
# ALLOWED_ORIGINS=http://localhost:3000

# Path to JWKS registry file (default: platformdirs user data dir)
# JWKS_REGISTRY_PATH=

# --- Dev / Debug ---
# These settings default to safe (off) for production.
# Set them in your local .env for development convenience.

# Enable OpenAPI docs at /docs, /redoc, /openapi.json (default: false)
ENABLE_DOCS=true

# Enable security response headers middleware (default: true). Set false if your reverse proxy handles them.
# SECURITY_HEADERS=true

# Python logging level (default: INFO)
LOG_LEVEL=DEBUG

# UI config JSON file path (default: built-in defaults)
# UI_CONFIG_PATH=
